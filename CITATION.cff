    given-names: "Laura"
    orcid: "https://orcid.org/0009-0002-8107-1806"
    affiliation: "Pontifical Catholic University of Rio de Janeiro (PUC-Rio)"
  - family-names: "Gonzaga"
    given-names: "Gustavo"
    affiliation: "Pontifical Catholic University of Rio de Janeiro (PUC-Rio)"
  - name: "Data Zoom (PUC-Rio)"
    email: "datazoom@econ.puc-rio.br"
    website: "https://datazoom.com.br/"
version: "1.2.0"
date-released: "2026-07-03"
license: MIT
repository-code: "https://github.com/datazoompuc/datazoom.amazonia"
repository-artifact: "https://CRAN.R-project.org/package=datazoom.amazonia"
url: "https://datazoom.com.br/datazoom.amazonia/"
keywords:
  - R
  - Amazon
  - Legal Amazon
  - Brazil
  - deforestation
  - PRODES
  - DETER
  - MapBiomas
  - IBGE
  - INPE
  - environmental data
